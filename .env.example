# ===========================================================================
#  GTMO VIP XAUUSD Telegram → MT5 Bot — configuration
#  Copy to ".env" and fill in. Never commit your real .env.
# ===========================================================================

# --- Telegram (https://my.telegram.org → API development tools) ------------
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here
# Phone in international format for first-time login (user account).
TELEGRAM_PHONE=+10000000000
# Channel: numeric id (-100xxxxxxxxxx), @username, or EXACT title "GTMO VIP".
TELEGRAM_CHANNEL=GTMO VIP
# Telethon session name (a .session file is created next to it).
TELEGRAM_SESSION=gtmo_session

# --- Parser ----------------------------------------------------------------
# regex  = fast, deterministic, no network
# ai     = every message parsed by the LLM (most robust, adds latency)
# hybrid = regex first, AI only when regex is unsure (recommended)
PARSER_MODE=hybrid
# AI provider: gemini (fastest) or anthropic
AI_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (only if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- MetaTrader 5 ----------------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server
# Optional path to terminal64.exe (if not auto-detected).
MT5_TERMINAL_PATH=
# Symbol and broker-specific variants to try, e.g. "XAUUSD.r,XAUUSDm".
MT5_SYMBOL=XAUUSD
MT5_SYMBOL_OVERRIDES=
# Max slippage for market orders, in points.
MT5_DEVIATION_POINTS=30
# Base for per-signal magic numbers.
MT5_MAGIC_BASE=990000

# --- Risk management -------------------------------------------------------
# Fraction of equity risked across an entire signal (all entries). 0.01 = 1%.
RISK_PER_SIGNAL=0.01
# Halt new trades once this fraction of start-of-day balance is lost. 0.05 = 5%.
MAX_DAILY_LOSS=0.05
MAX_OPEN_SIGNALS=3
MAX_LOT=5.0
MIN_LOT=0.01
FALLBACK_LOT=0.01
# Open one position per take-profit (true) or a single position (false).
ONE_POSITION_PER_TP=true
# XAUUSD pip size in price terms (70 pips ≈ 7.0 move). Usually 0.1.
PIP_SIZE=0.1

# --- Intelligence (scoring, adaptive risk, self-learning) ------------------
# Master switch for signal scoring + adaptive sizing.
INTEL_ENABLED=true
# Skip entries scoring below this (0..1). Higher = more selective.
MIN_SIGNAL_SCORE=0.45
# Refuse signals with no stop-loss.
REQUIRE_SL=true
# Minimum acceptable risk:reward (nearest TP distance / SL distance).
MIN_RR=0.8
REQUIRE_MIN_RR=false
# Skip if price already ran more than N×SL past the entry (anti-chasing).
MAX_CHASE_RATIO=2.0
# Smallest size multiplier a "take" can produce (0..1).
MIN_SIZE_FACTOR=0.4
# Ignore the recent-performance edge until this many trades are journaled.
MIN_TRADES_FOR_EDGE=15
# Adaptive risk: shrink size after losing streaks / drawdown, restore on recovery.
ADAPTIVE_RISK=true
LOSS_STREAK_THROTTLE=3
THROTTLE_FACTOR=0.5
DRAWDOWN_THROTTLE=0.08
MAX_SIZE_MULTIPLIER=1.0
MIN_SIZE_MULTIPLIER=0.25
# Parser self-learning: queue uncertain messages for review.
REVIEW_ENABLED=true

# --- Execution quality (trailing stop / profit lock / spread) --------------
TRAILING_ENABLED=true
# Begin trailing once a position is this many pips in profit.
TRAIL_START_PIPS=100
# Keep the stop this many pips behind price once trailing.
TRAIL_DISTANCE_PIPS=80
# Move SL to entry once the first TP is hit.
LOCK_AFTER_TP=true
# Seconds between trailing/monitor passes.
MONITOR_INTERVAL=2.0
# Skip entries when spread exceeds this many pips (0 = disabled).
MAX_SPREAD_PIPS=0

# --- Condition filters -----------------------------------------------------
FILTERS_ENABLED=false
# Allowed trading windows (UTC), comma-separated, e.g. "08:00-16:00,18:00-22:00".
TRADING_SESSIONS=
# News/volatility blackout windows (UTC), e.g.
# "2026-06-04T12:00/2026-06-04T13:00,2026-06-05T14:30/2026-06-05T15:00".
NEWS_BLACKOUT=

# --- Telegram alerts & remote control --------------------------------------
ALERTS_ENABLED=true
TELEGRAM_CONTROL_ENABLED=true
# Chat for alerts & commands (id/@username). Empty → your own Saved Messages.
CONTROL_CHAT=
DAILY_SUMMARY=true

# --- Multi-symbol ----------------------------------------------------------
# Comma-separated symbols the bot will trade (first is the default).
SYMBOLS=XAUUSD

# --- Dashboard -------------------------------------------------------------
# Optional token protecting the dashboard + control API (recommended if exposed).
DASHBOARD_TOKEN=

# --- Runtime ---------------------------------------------------------------
# IMPORTANT: keep DRY_RUN=true until you've verified parsing & sizing!
DRY_RUN=true
LOG_LEVEL=INFO
LOG_DIR=logs
STATE_FILE=state/active_signals.json
# Ignore messages older than this many seconds at startup.
MAX_MESSAGE_AGE=120
# If this file exists, no new trades are placed (emergency kill switch).
EMERGENCY_STOP_FILE=.EMERGENCY_STOP
